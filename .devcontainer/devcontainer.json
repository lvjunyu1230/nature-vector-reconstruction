{
  "name": "Nature vector reconstruction + Inkscape desktop",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "postCreateCommand": "python3 -m pip install --user -r requirements.txt",
  "postStartCommand": "bash -lc 'nohup ./tools/start_inkscape_desktop.sh > /tmp/inkscape-desktop.log 2>&1 &'",
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Inkscape in browser",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
